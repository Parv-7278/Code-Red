# Browser entry point and API allow-list. Use the exact public origin, without a trailing slash.
APP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Production-safe defaults. The optional simulator can still submit authenticated
# telemetry to this connected stack when the simulation Compose profile is enabled.
DEMO_MODE=false
VITE_DATA_MODE=CONNECTED

# Use the same long random value for both APIs and the simulator.
DEVICE_INGEST_API_KEY=replace-with-at-least-32-random-characters

# Required for connected deployment. Never commit real secret values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external language-model synthesis. Core deterministic predictions do not require it.
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Simulation and telemetry tuning.
TELEMETRY_INTERVAL_MS=2000
WS_TICK_INTERVAL_SECONDS=1.5
SIMULATION_MAX_DAYS=90
ALLOW_SYNTHETIC_ML=false
SIMULATED_BANDWIDTH_KBPS=64
NORMAL_PACKET_PROCESSING_INTERVAL_MS=800
EMERGENCY_PACKET_PROCESSING_INTERVAL_MS=50
BASE_PROPAGATION_DELAY_MS=250
