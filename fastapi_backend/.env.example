# POLARIS Antarctic Digital Twin - FastAPI Configuration
APP_NAME=POLARIS Antarctic Digital Twin Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5000
DEMO_MODE=true

# Supabase Credentials (PostgreSQL Data Integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEVICE_INGEST_API_KEY=replace-with-the-same-long-random-device-key-used-by-the-simulator

# Telemetry WebSocket Settings
WS_TICK_INTERVAL_SECONDS=1.5
SIMULATION_MAX_DAYS=90

# Optional external AI synthesis. Deterministic analytics work without this key.
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
