PORT=5000
NODE_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DEVICE_INGEST_API_KEY=replace-with-a-long-random-device-key
FASTAPI_URL=http://localhost:8000

# Supabase Credentials (Optional for local simulated fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Satellite Link Simulator Parameters
SIMULATED_BANDWIDTH_KBPS=64
NORMAL_PACKET_PROCESSING_INTERVAL_MS=800
EMERGENCY_PACKET_PROCESSING_INTERVAL_MS=50
BASE_PROPAGATION_DELAY_MS=250
